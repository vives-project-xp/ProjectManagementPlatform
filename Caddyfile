# HTTPS in front of the app (ADR 0001). Until VIVES IT provides a hostname and a
# certificate, Caddy's internal CA signs the certificate, so browsers warn.
{
	# Browsers send no server name (SNI) when connecting to an IP address;
	# without this Caddy cannot pick the certificate and the handshake fails.
	default_sni {$SITE_ADDRESS}
}

{$SITE_ADDRESS} {
	tls internal
	encode gzip

	header {
		# Never inside another site's frame (clickjacking).
		X-Frame-Options DENY
		# Browsers must not guess file types.
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Don't tell visitors which servers run behind this.
		-Server
	}

	# Browsers never call the backend: the frontend server does, inside Docker
	# (ADR 0003). Only the health check stays public, for the Deploy workflow.
	handle /api/health {
		reverse_proxy backend:8000
	}
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy frontend:8080
	}
}
