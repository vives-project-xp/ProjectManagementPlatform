# Copy to .env (never commit it). On the VM the real file lives at /opt/pmp/.env.

# Address Caddy serves on: the VM IP in production, localhost for local runs.
SITE_ADDRESS=localhost

# PostgreSQL
POSTGRES_USER=pmp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pmp

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Signs the frontend's browser session cookie. Generate with: openssl rand -hex 32
STORAGE_SECRET=change-me

# Starting accounts, one "role,email,password" line per Role (superuser, teacher,
# student). Created once at backend start if missing; never overwritten.
# On the VM: /opt/pmp/logins.txt. Never commit this file.
LOGINS_PATH=./logins.txt

# Test login: the login page lets anyone pick an active User and log in without a
# password. Only while the team is testing; remove it (or false) for real use.
# DEV_LOGIN=true

# GitHub (spec #49): the organisation that gets the Project repositories, and a
# fine-grained token for it (repository Administration: read and write,
# organisation Members: read). Never commit a real token. Without a token,
# creating repositories and checking members are off; looking up usernames still
# works.
# GITHUB_ORG=ProjectManagementVives
# GITHUB_TOKEN=github_pat_...

# Trello (spec #61): the API key and token of the dedicated Trello account that
# owns every Project's Workspace and board. Never commit a real token. Without
# them, creating boards is off.
# TRELLO_API_KEY=...
# TRELLO_TOKEN=...

# The 08:30 daily email (spec #68): the mailbox it is sent from (STARTTLS),
# e.g. a team Gmail with an app password. Never commit a real password.
# Without SMTP_HOST no email is sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=team@gmail.com
# SMTP_PASSWORD=app-password
# MAIL_FROM=VIVES Project Experience <team@gmail.com>
# SITE_URL=https://10.20.10.33

# Footer on every page (#79). Leave a line out to keep the VIVES default; set it
# to none (e.g. FOOTER_TIKTOK=none) to hide that link. Recreate the frontend
# after a change: docker compose up -d frontend
# FOOTER_INSTAGRAM=https://www.instagram.com/viveshogeschool
# FOOTER_TIKTOK=https://www.tiktok.com/@viveshogeschool
# FOOTER_YOUTUBE=https://www.youtube.com/vivesvideo
# FOOTER_LINKEDIN=https://www.linkedin.com/school/vives/
# FOOTER_PRIVACY_URL=https://www.vives.be/nl/over-vives/privacyverklaring
# FOOTER_ADDRESS=VIVES Brugge Xaverianenstraat · Xaverianenstraat 10, 8200 Brugge
