# Copy to .env (never commit it). On the VM the real file lives at /opt/pmp/.env.

# Address Caddy serves on: the VM IP in production, localhost for local runs.
SITE_ADDRESS=localhost

# PostgreSQL
POSTGRES_USER=pmp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pmp

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Signs the frontend's browser session cookie. Generate with: openssl rand -hex 32
STORAGE_SECRET=change-me

# Starting accounts, one "role,email,password" line per Role (superuser, teacher,
# student). Created once at backend start if missing; never overwritten.
# On the VM: /opt/pmp/logins.txt. Never commit this file.
LOGINS_PATH=./logins.txt

# Test login: the login page lets anyone pick an active User and log in without a
# password. Only while the team is testing; remove it (or false) for real use.
# DEV_LOGIN=true

# GitHub (spec #49): the organisation that gets the Project repositories, and a
# fine-grained token for it (repository Administration: read and write,
# organisation Members: read). Never commit a real token. Without a token,
# creating repositories and checking members are off; looking up usernames still
# works.
# GITHUB_ORG=ProjectManagementVives
# GITHUB_TOKEN=github_pat_...
