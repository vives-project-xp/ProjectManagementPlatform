# Copy to .env (never commit it). On the VM the real file lives at /opt/pmp/.env.

# Address Caddy serves on: the VM IP in production, localhost for local runs.
SITE_ADDRESS=localhost

# PostgreSQL
POSTGRES_USER=pmp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pmp

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Signs the frontend's browser session cookie. Generate with: openssl rand -hex 32
STORAGE_SECRET=change-me

# Starting accounts, one "role,email,password" line per Role (superuser, teacher,
# student). Created once at backend start if missing; never overwritten.
# On the VM: /opt/pmp/logins.txt. Never commit this file.
LOGINS_PATH=./logins.txt
